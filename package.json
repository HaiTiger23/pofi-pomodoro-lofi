{
  "name": "pofi",
  "version": "1.3.0",
  "description": "Pofi - A cozy Pomodoro and lofi music desktop app",
  "author": "Hai Dev",
  "license": "MIT",
  "private": true,
  "main": "elect.js",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build:vue": "vue-cli-service build",
    "start": "npm run build:vue && node scripts/run-electron.js .",
    "watch": "nodemon --watch elect.js --exec electron .",
    "dev": "node scripts/dev.js",
    "electron:dev": "node scripts/electron-dev.js",
    "generate-icons": "electron-icon-builder --input=./pofi_logo.png --output=./icons",
    "package": "npm run build:vue && electron-packager . Pofi --platform=darwin --arch=x64 --out=package --overwrite --icon=./icons/icons/mac/icon.icns --extra-resource=sounds --ignore=\"^/(tests|scripts|package|dist_electron|src|.git)(/|$)\"",
    "package-win": "npm run build:vue && electron-packager . Pofi --platform=win32 --arch=x64 --out=package --overwrite --icon=./icons/icons/win/icon.ico --extra-resource=sounds --ignore=\"^/(tests|scripts|package|dist_electron|src|.git)(/|$)\"",
    "build:electron": "vue-cli-service build && electron-builder",
    "build:win": "vue-cli-service build && electron-builder --win nsis --x64 --publish never",
    "build": "npm run build:vue",
    "test": "node --test tests/*.test.js",
    "lint": "vue-cli-service lint --no-fix",
    "test:electron": "node scripts/run-electron.js --hidden tests/smoke.electron.js",
    "test:glass": "node scripts/run-electron.js --hidden tests/glass.electron.js"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "core-js": "^3.8.3",
    "express": "^4.21.2",
    "flowbite": "^1.6.5",
    "howler": "^2.2.3",
    "nodemon": "^2.0.22",
    "primeicons": "^7.0.0",
    "remixicon": "^3.3.0",
    "sound-play": "^1.1.0",
    "vue": "^3.2.13",
    "vuex": "^4.1.0",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "autoprefixer": "^10.4.14",
    "electron": "^25.1.0",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-packager": "^17.1.2",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "build": {
    "appId": "com.pofi-hai-dev.id",
    "productName": "Pofi",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "elect.js",
      "preload.js",
      "electron/**/*",
      "shared/**/*",
      "dist/**/*",
      "pofi_logo.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icons/win/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/icons/mac/icon.icns"
    },
    "extraResources": [
      {
        "from": "sounds",
        "to": "sounds",
        "filter": [
          "**/*.mp3"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sound-play/**"
    ]
  }
}
